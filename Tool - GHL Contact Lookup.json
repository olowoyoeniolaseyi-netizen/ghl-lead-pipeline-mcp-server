{
  "name": "Tool - GHL Contact Lookup",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "email"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.3,
      "position": [
        -32,
        0
      ],
      "id": "n1",
      "name": "When Executed by Another Workflow"
    },
    {
      "parameters": {
        "url": "https://services.leadconnectorhq.com/contacts/",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "locationId",
              "value": "YOUR_GHL_LOCATION_ID"
            },
            {
              "name": "query",
              "value": "={{ $json.email }}"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Version",
              "value": "2021-07-28"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        192,
        0
      ],
      "id": "n2",
      "name": "HTTP Request"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 4
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.contacts && $json.contacts.length > 0 }}",
              "rightValue": "={{ 0 }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.4,
      "position": [
        416,
        0
      ],
      "id": "n3",
      "name": "If"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f1",
              "name": "found",
              "value": "true",
              "type": "string"
            },
            {
              "id": "f2",
              "name": "name",
              "value": "={{ $json.contacts[0].contactName }}",
              "type": "string"
            },
            {
              "id": "f3",
              "name": "tags",
              "value": "={{ $json.contacts[0].tags }}",
              "type": "string"
            },
            {
              "id": "f4",
              "name": "source",
              "value": "={{ $json.contacts[0].source }}",
              "type": "string"
            },
            {
              "id": "f5",
              "name": "contactId",
              "value": "={{ $json.contacts[0].id }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        640,
        -96
      ],
      "id": "n4",
      "name": "Edit Fields"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f6",
              "name": "found",
              "value": "false",
              "type": "string"
            },
            {
              "id": "f7",
              "name": "message",
              "value": "No contact found with that email",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        640,
        96
      ],
      "id": "n5",
      "name": "Edit Fields1"
    }
  ],
  "pinData": {},
